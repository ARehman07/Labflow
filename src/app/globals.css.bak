@import 'tailwindcss';

/* ── Design tokens (CSS-first, single source of truth) ── */
@theme {
  /* Brand — indigo / iris (LabFlow Nova) */
  --color-brand-50: #eef2ff;
  --color-brand-100: #e0e7ff;
  --color-brand-200: #c7d2fe;
  --color-brand-300: #a5b4fc;
  --color-brand-400: #818cf8;
  --color-brand-500: #6366f1;
  --color-brand-600: #4f46e5;
  --color-brand-700: #4338ca;
  --color-brand-800: #3730a3;
  --color-brand-900: #312e81;
  --color-brand: #4f46e5;
  --color-brand-dark: #4338ca;

  /* Dark chrome (sidebar + top bar) */
  --color-ink: #0b0f1a;
  --color-ink-2: #111726;
  --color-ink-line: #1f2637;
  --color-ink-muted: #8b93a7;

  /* Content canvas */
  --color-canvas: #f6f7fb;

  /* Secondary accent — cyan (for data / highlights) */
  --color-clinic-50: #ecfeff;
  --color-clinic-100: #cffafe;
  --color-clinic-500: #06b6d4;
  --color-clinic-600: #0891b2;
  --color-clinic-700: #0e7490;

  /* Workflow status tokens */
  --color-status-booked: #64748b;
  --color-status-collected: #2563eb;
  --color-status-progress: #d97706;
  --color-status-saved: #7c3aed;
  --color-status-approved: #16a34a;
  --color-status-delivered: #0d9488;
  --color-status-alert: #dc2626;

  /* Typography */
  --font-sans: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  --font-urdu: 'Noto Sans Arabic', 'Segoe UI', Tahoma, sans-serif;

  /* Radius */
  --radius-xl: 0.875rem;
  --radius-2xl: 1.125rem;

  /* Shadows */
  --shadow-card: 0 1px 2px 0 rgb(15 23 42 / 0.04), 0 1px 3px 0 rgb(15 23 42 / 0.06);
  --shadow-card-hover: 0 12px 28px -8px rgb(30 27 75 / 0.16), 0 2px 8px -2px rgb(30 27 75 / 0.08);
  --shadow-dropdown: 0 12px 32px -8px rgb(15 23 42 / 0.22), 0 4px 12px -4px rgb(15 23 42 / 0.12);
  --shadow-glow: 0 0 0 4px rgb(99 102 241 / 0.14);

  /* Animations */
  --animate-fade-in: fade-in 0.25s ease-out;
  --animate-fade-in-up: fade-in-up 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  --animate-scale-in: scale-in 0.15s cubic-bezier(0.22, 1, 0.36, 1);
  --animate-slide-in-right: slide-in-right 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  --animate-pulse-soft: pulse-soft 1.8s ease-in-out infinite;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes fade-in-up {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes scale-in {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
@keyframes slide-in-right {
  from { opacity: 0; transform: translateX(16px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
@keyframes shimmer {
  100% { transform: translateX(100%); }
}

/* v3-compat: default border & ring colour to slate-200 (v4 defaults to currentColor) */
@layer base {
  *,
  ::after,
  ::before,
  ::backdrop {
    border-color: var(--color-slate-200, currentColor);
  }
}

:root {
  color-scheme: light;
}

html {
  -webkit-text-size-adjust: 100%;
  /* Always reserve the scrollbar gutter so switching between short/long views
     doesn't shift the layout horizontally. */
  scrollbar-gutter: stable;
}

body {
  @apply text-slate-800 antialiased;
  font-size: 15px;
  background:
    radial-gradient(1100px 560px at 100% -8%, rgba(99, 102, 241, 0.07), transparent 60%),
    radial-gradient(820px 480px at -8% 8%, rgba(6, 182, 212, 0.05), transparent 55%),
    var(--color-canvas);
  background-attachment: fixed;
}

/* Refined focus ring across the app */
*:focus-visible {
  outline: none;
  @apply ring-2 ring-brand-500/60 ring-offset-1 ring-offset-white;
}

/* Slim, modern scrollbars */
* {
  scrollbar-width: thin;
  scrollbar-color: rgb(203 213 225) transparent;
}
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-thumb { background: rgb(203 213 225); border-radius: 9999px; }
*::-webkit-scrollbar-thumb:hover { background: rgb(148 163 184); }

@layer components {
  .card {
    @apply rounded-2xl border border-slate-200/70 bg-white shadow-card transition-shadow duration-300;
  }
  .card-hover {
    @apply transition-all duration-300 hover:-translate-y-0.5 hover:shadow-card-hover;
  }
  .field {
    @apply w-full rounded-xl border border-slate-300 bg-white px-3.5 py-2.5 text-slate-800
      placeholder:text-slate-400 transition-all duration-200
      focus:border-brand-500 focus:ring-4 focus:ring-brand-500/10;
  }
  .field:disabled {
    @apply cursor-not-allowed bg-slate-50 text-slate-500;
  }
  .label {
    @apply mb-1.5 block text-sm font-medium text-slate-700;
  }
  .pill {
    @apply inline-flex items-center justify-center gap-1 whitespace-nowrap rounded-full px-2.5 py-1
      text-xs font-semibold leading-none;
  }
  .section-title {
    @apply text-sm font-semibold uppercase tracking-wide text-slate-500;
  }
  .skeleton {
    @apply relative overflow-hidden rounded-lg bg-slate-200/70;
  }
  .skeleton::after {
    content: '';
    @apply absolute inset-0 -translate-x-full;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
    animation: shimmer 1.5s infinite;
  }
}

/* Staggered list entrance */
.stagger > * {
  animation: fade-in-up 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.stagger > *:nth-child(1) { animation-delay: 0.02s; }
.stagger > *:nth-child(2) { animation-delay: 0.06s; }
.stagger > *:nth-child(3) { animation-delay: 0.1s; }
.stagger > *:nth-child(4) { animation-delay: 0.14s; }
.stagger > *:nth-child(5) { animation-delay: 0.18s; }
.stagger > *:nth-child(6) { animation-delay: 0.22s; }
.stagger > *:nth-child(7) { animation-delay: 0.26s; }
.stagger > *:nth-child(8) { animation-delay: 0.3s; }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ── Urdu (RTL) typography ── */
html[dir='rtl'] body {
  @apply font-urdu;
  line-height: 1.9;
}
html[dir='rtl'] .pill {
  @apply px-3 py-1.5;
  line-height: 1.4;
}
html[dir='rtl'] .field,
html[dir='rtl'] .btn {
  @apply py-3;
  line-height: 1.7;
}

/* ── Print / Save-as-PDF ── */
@media print {
  .no-print { display: none !important; }
  html, body { background: #fff !important; }
  body * { visibility: hidden !important; }
  .print-area, .print-area * { visibility: visible !important; }
  .print-area {
    position: absolute !important;
    inset: 0 auto auto 0;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
  }
  .print-area .card { box-shadow: none !important; border: none !important; }
  @page { margin: 14mm; }
}
