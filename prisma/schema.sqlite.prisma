  visit          Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  grossAmount    Decimal
  discount       Decimal        @default(0)
  /// Which rule produced the discount, and the card if one applied.
  discountSource String @default("NONE")
  familyCardId   String?
  familyCard     FamilyCard?    @relation(fields: [familyCardId], references: [id])
  /// Family-card joining fee charged on this slip. Added AFTER the discount —
  /// the fee is never discounted.
  familyCardFee  Decimal        @default(0)
  /// Who authorised a CARE_OF discount, on invoices raised while that existed.
  /// Retired — new invoices never set it.
  careOfUserId   String?
  careOfUser     User?          @relation("InvoiceCareOf", fields: [careOfUserId], references: [id])
  netAmount      Decimal
  paidAmount     Decimal        @default(0)
  status         String  @default("DUE")

  payments Payment[]
  refunds  Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([careOfUserId])
}

model Payment {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal
  method       String   @default("CASH")
  /// Which till or bank account the money went into.
  accountId    String?
  account      PaymentAccount? @relation(fields: [accountId], references: [id])
  receivedById String
  at           DateTime        @default(now())

  @@index([tenantId])
}

model Refund {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount       Decimal
  reason       String?
  /// Which till or bank account the money was paid back from.
  accountId    String?
  account      PaymentAccount? @relation(fields: [accountId], references: [id])
  approvedById String
  at           DateTime        @default(now())

  @@index([tenantId])
}

model Commission {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctorId String
  doctor   Doctor           @relation(fields: [doctorId], references: [id])
  visitId  String
  visit    Visit            @relation(fields: [visitId], references: [id])
  amount   Decimal
  status   String @default("ACCRUED")
  at       DateTime         @default(now())

  @@index([tenantId])
}

model LedgerEntry {
  id       String       @id @default(cuid())
  tenantId String
  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch       @relation(fields: [branchId], references: [id])
  type     String
  method   String @default("CASH")
  category String
  amount   Decimal
  note     String?
  at       DateTime     @default(now())

  @@index([at])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Reporting / Delivery
// ─────────────────────────────────────────────────────────────
model ReportTemplate {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id])
  name         String
  headerHtml   String?
  footerHtml   String?
  signatureImg String?

  reports Report[]

  @@index([tenantId])
}

model Report {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId     String
  visit       Visit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  templateId  String?
  template    ReportTemplate? @relation(fields: [templateId], references: [id])
  publicToken String          @unique // random, expiring — safe shareable link
  tokenExpiry DateTime?
  generatedAt DateTime        @default(now())

  deliveries Delivery[]

  @@index([tenantId])
}

model Delivery {
  id       String          @id @default(cuid())
  tenantId String
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportId String
  report   Report          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  channel  String
  status   String  @default("QUEUED")
  at       DateTime        @default(now())

  @@index([tenantId])
}

/// A one-time code issued to a patient's mobile for portal access.
///
/// Stored hashed: a 6-digit code is trivially reversible from a plain-text
/// database, and this table is a prime target. Attempts and a send cooldown
/// live here too, so limits survive a restart and hold across instances —
/// an in-memory Map gives neither.
model PortalOtp {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mobile          String
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  /// Sends in the current hour, for rate limiting.
  sendCount       Int      @default(1)
  lastSentAt      DateTime @default(now())
  windowStartedAt DateTime @default(now())

  @@unique([tenantId, mobile])
  @@index([tenantId])
}

/// A short-lived portal session. The token is stored hashed — possessing the
/// database must not grant the ability to impersonate a patient.
model PortalSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  mobile    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Queue / Notifications / Audit
// ─────────────────────────────────────────────────────────────
model QueueToken {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId  String      @unique
  visit    Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  number   Int
  status   String @default("WAITING")
  at       DateTime    @default(now())

  @@index([tenantId])
}

model Notification {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message  String
  isRead   Boolean  @default(false)
  at       DateTime @default(now())

  @@index([tenantId])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  entity   String
  entityId String
  action   String
  before   String?
  after    String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@index([tenantId])
}

/// A till or bank account money is received into: Cash, JazzCash, a bank.
/// Payments and refunds name one, so the day's cash can be counted per account.
model PaymentAccount {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  method    String @default("CASH")
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)

  payments Payment[]
  refunds  Refund[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A file attached to a booking: a prescription, a referral letter, an ID scan.
/// Held in the database because files are small and the app runs where there
/// is no persistent disk.
model Attachment {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId      String
  visit        Visit      @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// Set when the file belongs to one test, e.g. a reference lab's report.
  orderLineId  String?
  orderLine    OrderLine? @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  /// BOOKING (came with the patient) or OUTSOURCE_REPORT (a reference lab's report).
  kind         String     @default("BOOKING")
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime   @default(now())

  @@index([visitId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Pricing: packages, rate groups, collection points
// ─────────────────────────────────────────────────────────────

/// A set of tests sold together at one price, e.g. "Medical Package".
model TestPackage {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  price    Decimal
  isActive Boolean @default(true)

  items      TestPackageItem[]
  orderLines OrderLine[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TestPackageItem {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageId String
  package   TestPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  testId    String
  test      Test        @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([packageId, testId])
  @@index([tenantId])
}

/// A price list: its own test prices and a default discount — for a B2B lab,
/// a collection point, a panel of patients.
model RateGroup {
  id                 String  @id @default(cuid())
  tenantId           String
  tenant             Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  defaultDiscountPct Decimal @default(0)
  isActive           Boolean @default(true)

  prices           RateGroupPrice[]
  visits           Visit[]
  partnerLabs      PartnerLab[]
  collectionPoints CollectionPoint[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RateGroupPrice {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rateGroupId String
  rateGroup   RateGroup @relation(fields: [rateGroupId], references: [id], onDelete: Cascade)
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  price       Decimal

  @@unique([rateGroupId, testId])
  @@index([tenantId])
}

/// A place samples are taken outside the branch, with its own price list.
model CollectionPoint {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch     @relation(fields: [branchId], references: [id])
  name        String
  phone       String?
  address     String?
  rateGroupId String?
  rateGroup   RateGroup? @relation(fields: [rateGroupId], references: [id], onDelete: SetNull)
  isActive    Boolean    @default(true)

  visits Visit[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// B2B partner accounts
// ─────────────────────────────────────────────────────────────

/// Money movements on a partner lab's account. A CHARGE raises what the
/// partner owes; PAYMENT and TOPUP lower it. Balance = charges − credits.
model PartnerLedgerEntry {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partnerLabId String
  partnerLab   PartnerLab        @relation(fields: [partnerLabId], references: [id], onDelete: Cascade)
  visitId      String?
  visit        Visit?            @relation(fields: [visitId], references: [id], onDelete: SetNull)
  type         String
  amount       Decimal
  note         String?
  createdById  String
  at           DateTime          @default(now())

  @@index([partnerLabId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Culture & sensitivity
// ─────────────────────────────────────────────────────────────

model CultureResult {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderLineId   String               @unique
  orderLine     OrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  growth        Boolean              @default(false)
  organism      String?
  colonyCount   String?
  incubation    String?
  remarks       String?
  sensitivities CultureSensitivity[]
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
}

model CultureSensitivity {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cultureResultId String
  cultureResult   CultureResult @relation(fields: [cultureResultId], references: [id], onDelete: Cascade)
  antibiotic      String
  /// S (sensitive), I (intermediate) or R (resistant).
  result          String
  mic             String?
  sortOrder       Int           @default(0)

  @@index([tenantId])
}

/// The lab's antibiotic panel, offered when entering a sensitivity.
model Antibiotic {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Quality control
// ─────────────────────────────────────────────────────────────

/// A control material run for one parameter at one level, with its target
/// mean and SD — what Levey-Jennings charts and Westgard rules are read against.
model QcMaterial {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  name        String
  level       String
  lotNo       String?
  mean        Decimal
  sd          Decimal
  expiresAt   DateTime?
  isActive    Boolean       @default(true)
  runs        QcRun[]
  createdAt   DateTime      @default(now())

  @@index([tenantId])
}

model QcRun {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  materialId  String
  material    QcMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  value       Decimal
  runAt       DateTime   @default(now())
  enteredById String
  /// Westgard rules this run broke, e.g. "1-3s,R-4s". Empty when in control.
  violations  String?
  rejected    Boolean    @default(false)
  note        String?

  @@index([materialId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Lab stock
// ─────────────────────────────────────────────────────────────

model InventoryItem {
  id           String           @id @default(cuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  unit         String           @default("pcs")
  quantity     Decimal          @default(0)
  reorderLevel Decimal          @default(0)
  expiresAt    DateTime?
  isActive     Boolean          @default(true)
  movements    StockMovement[]
  consumables  TestConsumable[]
  createdAt    DateTime         @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// One line in the stock register: received, issued to a department, used by a
/// test, adjusted. Numbered so the paper register and the screen agree.
model StockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId       String
  item         InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type         String
  /// Positive in, negative out.
  quantity     Decimal
  balanceAfter Decimal
  department   String?
  issuedBy     String?
  receivedBy   String?
  note         String?
  orderLineId  String?
  orderLine    OrderLine?        @relation(fields: [orderLineId], references: [id], onDelete: SetNull)
  serialNo     Int
  createdById  String
  at           DateTime          @default(now())

  @@index([itemId])
  @@index([tenantId])
}

/// What one test uses up, deducted from stock when its sample is collected.
model TestConsumable {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  testId   String
  test     Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  itemId   String
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity Decimal

  @@unique([testId, itemId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────
// Analyzer interfacing
// ─────────────────────────────────────────────────────────────

/// An instrument (or the bridge PC beside it) allowed to post results. It
/// authenticates with an API key; only a hash of the key is stored.
model Analyzer {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String            @unique
  keyPrefix  String
  isActive   Boolean           @default(true)
  lastSeenAt DateTime?
  mappings   AnalyzerMapping[]
  messages   AnalyzerMessage[]
  createdAt  DateTime          @default(now())

  @@index([tenantId])
}

/// The instrument's own code for a result (e.g. "WBC") → the lab's parameter.
model AnalyzerMapping {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analyzerId  String
  analyzer    Analyzer      @relation(fields: [analyzerId], references: [id], onDelete: Cascade)
  code        String
  parameterId String
  parameter   TestParameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@unique([analyzerId, code])
  @@index([tenantId])
}

/// Every message an analyzer sent, kept so a result that did not land can be traced.
model AnalyzerMessage {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  analyzerId String
  analyzer   Analyzer @relation(fields: [analyzerId], references: [id], onDelete: Cascade)
  barcode    String?
  payload    String
  /// ACCEPTED, PARTIAL or REJECTED.
  status     String
  detail     String?
  at         DateTime @default(now())

  @@index([analyzerId])
  @@index([tenantId])
}
