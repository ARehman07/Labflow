/// A critical result is not communicated until a human has been told.
/// One row is opened automatically whenever a result flags CRITICAL; it stays
/// open (notifiedAt IS NULL) until somebody records the call. ISO 15189 asks
/// for exactly this.
model CriticalNotification {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  resultValueId String      @unique
  resultValue   ResultValue @relation(fields: [resultValueId], references: [id], onDelete: Cascade)

  notifiedById  String?
  notifiedBy    User?     @relation("CriticalNotifiedBy", fields: [notifiedById], references: [id])
  notifiedTo    String? // who was actually reached
  notifiedPhone String?
  method        String? // phone / whatsapp / in person
  notifiedAt    DateTime?

  acknowledgedBy String? // their name, in their words
  acknowledgedAt DateTime?
  notes          String?

  createdAt DateTime @default(now())

  @@index([tenantId, notifiedAt])
  @@index([tenantId])
}

/// Conditions the lab is legally obliged to report to a health authority.
/// Seeded per lab from the national notifiable-disease list.
model NotifiableCondition {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code      String // SNOMED or the authority's own code
  name      String
  authority String?
  isActive  Boolean @default(true)

  reports NotifiableReport[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

/// One reportable finding. Open (reportedAt IS NULL) until it is filed.
model NotifiableReport {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  resultValueId String
  resultValue   ResultValue         @relation(fields: [resultValueId], references: [id], onDelete: Cascade)
  conditionId   String
  condition     NotifiableCondition @relation(fields: [conditionId], references: [id])

  flaggedById String?
  flaggedBy   User?    @relation("NotifiableFlaggedBy", fields: [flaggedById], references: [id])
  flaggedAt   DateTime @default(now())

  reportedAt  DateTime?
  reportedTo  String?
  referenceNo String?
  notes       String?

  @@unique([resultValueId, conditionId])
  @@index([tenantId, reportedAt])
  @@index([tenantId])
}

/// A family discount card, held against a mobile number.
///
/// The mobile number IS the card — there is no separate card number to lose.
/// The rate is snapshotted at issue so a later change to the lab's policy does
/// not silently rewrite what past holders were promised.
model FamilyCard {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The card's identity. One card per number, per lab.
  mobile String

  primaryPatientId String
  primaryPatient   Patient @relation("FamilyCardPrimary", fields: [primaryPatientId], references: [id])

  /// Snapshot of Tenant.familyCardDiscountPct at the moment of issue.
  discountPct Decimal @default(0)
  /// Joining fee charged for this card, snapshotted at issue.
  feeAmount   Decimal @default(0)
  /// Snapshot of Tenant.familyCardMemberCap. Superadmin may change the policy
  /// later; existing cards keep the capacity they were sold.
  memberCap   Int     @default(6)

  isActive  Boolean   @default(true)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  issuedById String?
  issuedBy   User?   @relation("FamilyCardIssuedBy", fields: [issuedById], references: [id])

  members FamilyCardMember[]
  Invoice Invoice[]

  @@unique([tenantId, mobile])
  @@index([tenantId])
}

/// Membership of a family card. Rows are kept after removal (removedAt set)
/// so a past discount can still be explained.
model FamilyCardMember {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cardId String
  card   FamilyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  patientId String
  patient   Patient @relation("FamilyCardMembership", fields: [patientId], references: [id])

  /// Relation to the card holder. The holder themselves is SELF.
  relation String @default("OTHER")

  addedAt   DateTime  @default(now())
  removedAt DateTime?

  @@unique([cardId, patientId])
  @@index([tenantId])
  @@index([patientId])
}

