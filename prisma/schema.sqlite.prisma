/// A one-time code issued to a patient's mobile for portal access.
///
/// Stored hashed: a 6-digit code is trivially reversible from a plain-text
/// database, and this table is a prime target. Attempts and a send cooldown
/// live here too, so limits survive a restart and hold across instances —
/// an in-memory Map gives neither.
model PortalOtp {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mobile   String
  codeHash String
  expiresAt DateTime
  attempts  Int      @default(0)
  /// Sends in the current hour, for rate limiting.
  sendCount Int      @default(1)
  lastSentAt DateTime @default(now())
  windowStartedAt DateTime @default(now())

  @@unique([tenantId, mobile])
  @@index([tenantId])
}

/// A short-lived portal session. The token is stored hashed — possessing the
/// database must not grant the ability to impersonate a patient.
model PortalSession {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  mobile    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Queue / Notifications / Audit
// ─────────────────────────────────────────────────────────────
model QueueToken {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitId  String      @unique
  visit    Visit       @relation(fields: [visitId], references: [id], onDelete: Cascade)
  number   Int
  status   String @default("WAITING")
  at       DateTime    @default(now())

  @@index([tenantId])
}

model Notification {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message  String
  isRead   Boolean  @default(false)
  at       DateTime @default(now())

  @@index([tenantId])
}

model AuditLog {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  entity   String
  entityId String
  action   String
  before   String?
  after    String?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@index([tenantId])
}
