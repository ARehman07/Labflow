# --- Database ---
DATABASE_URL="postgresql://labflow:labflow_pw@localhost:5432/labflow?schema=public"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-real-secret"
AUTH_TRUST_HOST=true

# --- Redis (used from Phase 1: realtime, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (reports/scans, Phase 2) ---
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="labflow"

# --- Delivery providers (Phase 2, optional) ---
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
WHATSAPP_API_URL=""
WHATSAPP_TOKEN=""

# --- AI result summary (optional) ---
AI_PROVIDER_KEY=""

# Portal OTP — LOCAL DEVELOPMENT ONLY.
# When true, the one-time code is returned in the API response so you can log in
# without an SMS provider. This is an authentication bypass: anyone who knows a
# patient's mobile number can read the code. Ignored when NODE_ENV=production.
PORTAL_DEV_OTP=false
